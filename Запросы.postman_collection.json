{
  "info": {
    "name": "РБПО Лаба3 — театр",
    "description": "Запустить приложение и выполнить всю коллекцию через Run. Даты и id заполняются автоматически. После проверки созданные записи удаляются. Тестовые данные приложения сохраняются.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key": "baseUrl", "value": "http://localhost:8082"}],
  "item": [
    {
      "name": "1. Создать данные и проверить чтение и изменение",
      "item": [
        {
          "name": "01. Создать спектакль",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/plays",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"название\": \"Проверка: Ревизор\", \"длительностьМинут\": 100, \"возрастноеОграничение\": 12}"}
          },
          "event": [
            {"listen": "prerequest", "script": {"exec": [
              "const день = 24 * 60 * 60 * 1000;",
              "pm.collectionVariables.set(\"futureStart\", new Date(Date.now() + 7 * день).toISOString().slice(0, 19));",
              "pm.collectionVariables.set(\"pastStart\", new Date(Date.now() - 2 * день).toISOString().slice(0, 19));"
            ]}},
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"playId\", pm.response.json().id);"
            ]}}
          ]
        },
        {
          "name": "02. Список спектаклей",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/plays"
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Получен список\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]}}
          ]
        },
        {
          "name": "03. Один спектакль",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/plays/{{playId}}"
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Нужная запись\", () => pm.expect(pm.response.json().id).to.equal(Number(pm.collectionVariables.get(\"playId\"))));"
            ]}}
          ]
        },
        {
          "name": "04. Изменить спектакль",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/plays/{{playId}}",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"длительностьМинут\": 110}"}
          },
          "event": [
            {"listen": "test", "script": {"exec": [
              "pm.test(\"Код 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"длительностьМинут\", () => pm.expect(pm.response.json().длительностьМинут).to.equal(110));"
            ]}}
          ]
        },
